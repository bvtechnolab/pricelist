<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_bv_multi_pricelist" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bv.multi.pricelist</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="bv_multi_pricelist_enabled" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="after">
                <field name="bv_multi_pricelist_enabled" column_invisible="1"/>
                <field name="bv_line_pricelist_id" optional="show" readonly="parent.state not in ['draft', 'sent']" column_invisible="not parent.bv_multi_pricelist_enabled"/>
                <field name="bv_cost_price" optional="hide" column_invisible="not parent.bv_multi_pricelist_enabled"/>
                <field name="bv_margin_amount" optional="hide" column_invisible="not parent.bv_multi_pricelist_enabled"/>
                <field name="bv_margin_percentage" optional="hide" column_invisible="not parent.bv_multi_pricelist_enabled"/>
                <button name="action_open_bv_pricelist_wizard" type="object" string="Apply" class="btn-primary" invisible="not bv_multi_pricelist_enabled or parent.state not in ['draft', 'sent']"/>
            </xpath>
        </field>
    </record>
</odoo>
