<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_bv_multi_pricelist" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bv.multi.pricelist</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting id="bv_multi_pricelist_setting" help="Allow applying different pricelists per sale order line using a wizard.">
                    <field name="bv_enable_multi_pricelist"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
